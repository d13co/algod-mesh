# Generated by deploy/homebrew/render.sh in d13co/algod-mesh; the release
# workflow updates it on every v* tag. Edit the template there, not this file.
class AlgodMesh < Formula
  desc "Mesh load balancer for algod REST endpoints"
  homepage "https://github.com/d13co/algod-mesh"
  version "@VER@"

  # The release's static binaries, one per platform
  on_macos do
    on_arm do
      url "@URL@/algod-mesh-darwin-arm64"
      sha256 "@SHA_DARWIN_ARM64@"
    end
    on_intel do
      url "@URL@/algod-mesh-darwin-amd64"
      sha256 "@SHA_DARWIN_AMD64@"
    end
  end
  on_linux do
    on_arm do
      url "@URL@/algod-mesh-linux-arm64"
      sha256 "@SHA_LINUX_ARM64@"
    end
    on_intel do
      url "@URL@/algod-mesh-linux-amd64"
      sha256 "@SHA_LINUX_AMD64@"
    end
  end

  def install
    os = OS.mac? ? "darwin" : "linux"
    arch = Hardware::CPU.arm? ? "arm64" : "amd64"
    bin.install "algod-mesh-#{os}-#{arch}" => "algod-mesh"
  end

  def post_install
    # not etc/algod-mesh: brew cleanup prunes it while it is empty, so the caveats make it
    (var/"algod-mesh").mkpath # the service's working directory, for state files
    (var/"log").mkpath # the service's log_path
  end

  def caveats
    <<~EOS
      The service reads #{etc}/algod-mesh/config.yaml. Start from an example:
        mkdir -p #{etc}/algod-mesh
        algod-mesh config example -o #{etc}/algod-mesh/config.yaml
      and set local.data_dir to your node's data directory (#{var}/dtalgorand for the
      dtalgorand formula). Keep state files (registry.cache, rate limit state_file) under
      #{var}/algod-mesh. Check it with
        algod-mesh config check -config #{etc}/algod-mesh/config.yaml

      Start the agent, and have it start at login:
        brew services start algod-mesh

      An upgrade leaves the running agent on the old version until
        brew services restart algod-mesh

      algod-mesh-autoconfig and algod-mesh-setup set up Linux hosts with systemd and are not
      installed here; on Debian and Ubuntu the apt package from https://apt.d13.co has them.
    EOS
  end

  service do
    run [opt_bin/"algod-mesh", "run", "-config", etc/"algod-mesh/config.yaml"]
    keep_alive true
    working_dir var/"algod-mesh"
    log_path var/"log/algod-mesh.log"
    error_log_path var/"log/algod-mesh.log"
  end

  test do
    assert_match(/^algod-mesh v#{Regexp.escape(version.to_s)}$/, shell_output("#{bin}/algod-mesh version"))
    system bin/"algod-mesh", "config", "example", "-o", testpath/"config.yaml"
    assert_path_exists testpath/"config.yaml"
  end
end
